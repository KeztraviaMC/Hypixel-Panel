{
    "_comment": "Hypixel Panel - Fabric egg (name-matched by runtime adapter to itzg TYPE=FABRIC)",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-08-18T00:00:00+00:00",
    "name": "Fabric",
    "author": "support@pterodactyl.io",
    "description": "Fabric is a lightweight, experimental modding toolchain for Minecraft. The runtime provisions the Fabric loader + server automatically.",
    "features": [
        "eula",
        "java_version",
        "pid_limit"
    ],
    "docker_images": {
        "Java 25": "ghcr.io/pterodactyl/yolks:java_25",
        "Java 21": "ghcr.io/pterodactyl/yolks:java_21",
        "Java 17": "ghcr.io/pterodactyl/yolks:java_17",
        "Java 16": "ghcr.io/pterodactyl/yolks:java_16",
        "Java 11": "ghcr.io/pterodactyl/yolks:java_11",
        "Java 8": "ghcr.io/pterodactyl/yolks:java_8"
    },
    "file_denylist": [],
    "startup": "java -Xms128M -XX:MaxRAMPercentage=95.0 -Dterminal.jline=false -Dterminal.ansi=true -jar {{SERVER_JARFILE}}",
    "config": {
        "files": "{\r\n    \"server.properties\": {\r\n        \"parser\": \"properties\",\r\n        \"find\": {\r\n            \"server-ip\": \"0.0.0.0\",\r\n            \"server-port\": \"{{server.build.default.port}}\",\r\n            \"query.port\": \"{{server.build.default.port}}\"\r\n        }\r\n    }\r\n}",
        "startup": "{\r\n    \"done\": \")! For help, type \"\r\n}",
        "logs": "{}",
        "stop": "stop"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Fabric provisioning handled by the Hypixel runtime adapter (itzg TYPE=FABRIC).\n# This install script only ensures the data dir exists.\nmkdir -p /mnt/server\nexit 0",
            "container": "ghcr.io/pterodactyl/installers:alpine",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Server Jar File",
            "description": "The name of the server jarfile to run the server with.",
            "env_variable": "SERVER_JARFILE",
            "default_value": "server.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|regex:/^([\\w\\d._-]+)(\\.jar)$/",
            "field_type": "text"
        },
        {
            "name": "Minecraft Version",
            "description": "The version of Minecraft to use. Use 'latest' for the newest stable release.",
            "env_variable": "MINECRAFT_VERSION",
            "default_value": "latest",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:20",
            "field_type": "text"
        },
        {
            "name": "Fabric Loader Version",
            "description": "The Fabric loader version. Use 'latest' for the newest loader.",
            "env_variable": "FABRIC_LOADER_VERSION",
            "default_value": "latest",
            "user_viewable": true,
            "user_editable": true,
            "rules": "nullable|string|max:20",
            "field_type": "text"
        }
    ]
}
